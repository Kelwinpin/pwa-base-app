{
  "expo": {
    "name": "Rede Life Saúde",
    "slug": "lifeinfit",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pwabaseapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFA311"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifeinfit.ally",
      "buildNumber": "1.0.7",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para videochamadas de teleconsulta com profissionais de saúde.",
        "NSMicrophoneUsageDescription": "Usado para áudio em teleconsultas.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:lifeinfit.com"
      ]
    },
    "android": {
      "package": "com.lifeinfitsaude.ally",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lifeinfit.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./app.plugin.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFA311",
          "dark": {
            "backgroundColor": "#FFA311"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "usesNonExemptEncryption": false,
            "manifestQueries": {
              "package": ["android.hardware.camera", "android.hardware.camera.autofocus"]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0c0623e-d941-40be-acc6-08bf31a931bd"
      }
    },
    "owner": "kelwin.pin"
  }
}
