{
  "expo": {
    "name": "ABC Goiânia",
    "slug": "abc-goiania",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pwabaseapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siscompy.abcgoiania",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para tirar fotos.",
        "NSFaceIDUsageDescription": "Usado para entrar no app com Face ID.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:siscompy.com"]
    },
    "androidNavigationBar": {
      "barStyle": "dark-content"
    },
    "android": {
      "package": "com.siscompy.abcgoiania",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "siscompy.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./app.plugin.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f2e9d6",
          "dark": {
            "backgroundColor": "#f2e9d6"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "usesNonExemptEncryption": false,
            "manifestQueries": {
              "package": [
                "android.hardware.camera",
                "android.hardware.camera.autofocus"
              ]
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2a5580",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "owner": "kelwin.pin"
  }
}
